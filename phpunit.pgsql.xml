<?xml version="1.0" encoding="UTF-8"?>
<!--
    ชุดเทสต์เดียวกัน แต่รันกับ PostgreSQL จริง

    ชุดปกติ (phpunit.xml) ใช้ SQLite in-memory ซึ่งเร็วแต่ปิดตาเรื่องพฤติกรรมที่ต่างกัน
    เช่น PostgreSQL abort ทั้ง transaction เมื่อคำสั่งใดผิดพลาด (SQLSTATE 25P02)
    ซึ่งเคยทำให้ตัวออกเลขเอกสารพังบน production ทั้งที่ผ่านทุกเทสต์บน SQLite
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <!-- คีย์เดียวกับ phpunit.xml — ใช้เฉพาะตอนเทสต์ ไม่ใช่คีย์ของระบบจริง -->
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <!-- ตรึง APP_URL ไม่ให้ .env ของเครื่องที่รันมาทับ — มีเทสต์ที่เทียบ URL แบบตายตัว -->
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- force="true" เพื่อทับค่าใน .env ของ CI ให้แน่ใจว่าชี้ PostgreSQL จริง -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="jeterp_test" force="true"/>
        <env name="DB_USERNAME" value="jeterp" force="true"/>
        <env name="DB_PASSWORD" value="jeterp" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
