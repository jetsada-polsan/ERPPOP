# Install as /etc/jeterp-backup/production.env with chmod 0600. Never commit values.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=jeterp
PGUSER=replace_me
PGPASSWORD=replace_me
APP_PATH=/var/www/jeterp
APP_STORAGE_PATH=/var/www/jeterp/storage/app
BACKUP_ROOT=/var/backups/jeterp
RCLONE_CONFIG=/etc/jeterp-backup/rclone.conf
RCLONE_CRYPT_REMOTE=gdrive-crypt:POPSTAR-ERP
KEEP_DAYS=14
TZ=Asia/Bangkok
