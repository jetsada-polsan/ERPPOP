# Install as /etc/jeterp-backup/local-dr.env with chmod 0600. Never commit values.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=replace_me
PGPASSWORD=replace_me
DR_DATABASE=jeterp_dr
APP_DB_USER=replace_me
DR_BACKUP_ROOT=/var/backups/jeterp-dr
DR_STORAGE_PATH=/srv/jeterp-dr/storage/app
RCLONE_CONFIG=/etc/jeterp-backup/rclone.conf
RCLONE_CRYPT_REMOTE=gdrive-crypt:POPSTAR-ERP
TZ=Asia/Bangkok
