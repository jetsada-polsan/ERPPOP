{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POPSTAR POS",
  "version": "1.5.2",
  "identifier": "th.co.popstar.pos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "POPSTAR POS",
      "width": 1024,
      "height": 700,
      "minWidth": 720,
      "minHeight": 560,
      "maximized": true,
      "center": true,
      "fullscreen": false,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https://erp.popstarcenter.com; connect-src ipc: http://ipc.localhost https://erp.popstarcenter.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "sql": {},
    "updater": {
      "endpoints": ["https://erp.popstarcenter.com/download/pos/latest.json"],
      "pubkey": "__TAURI_UPDATER_PUBLIC_KEY__",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
